# ===============================================
# إعدادات بيئة العمل والإنتاج - منظومة سودرا للشحن
# SUDRA EXPRESS - ENVIRONMENT CONFIGURATION
# ===============================================

# 1. إعدادات قاعدة البيانات (MySQL Database)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shipping_db
DB_USER=root
DB_PASS=your_secure_db_password_here

# 2. إعدادات الخادم والروابط (Server & API URLs)
APP_ENV=production
APP_DEBUG=false
APP_URL=https://app.sudra.sa
API_BASE_URL=https://app.sudra.sa/api

# 3. إعدادات البريد الإلكتروني (Mail & SMTP)
MAIL_DRIVER=mail
MAIL_FROM_ADDRESS=noreply@sudra.sa
MAIL_FROM_NAME="سودرا للشحن والتوصيل"
MAIL_REPLY_TO=info@sudra.sa

# 4. إعدادات الجلسات والأمان (Security & Tokens)
JWT_SECRET=your_32_characters_random_secret_here
TOKEN_EXPIRY_HOURS=720
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_DECAY_MINUTES=15
